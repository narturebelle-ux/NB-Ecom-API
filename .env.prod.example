# Copy to .env and fill in real values to run/deploy under the "prod" Spring profile.
# Never commit the real .env file.

SPRING_PROFILES_ACTIVE=prod

# Supabase PostgreSQL — Session pooler connection string (prod instance).
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.lvtyxrjfnroopmlvnnqg
DB_PASSWORD=

PORT=8080

# Required — the app refuses to start in prod without this (or Application Default Credentials
# on GCP/Cloud Run). Never left blank here, unlike the test/local example files.
FIREBASE_SERVICE_ACCOUNT_BASE64=
