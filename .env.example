# Copy this file to .env and fill in real values. Never commit the real .env file.

# Supabase PostgreSQL — Session pooler connection string.
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.lvtyxrjfnroopmlvnnqg
DB_PASSWORD=

PORT=8080

# Base64-encoded Firebase service account JSON. Required in prod/stage (app fails to start without
# it or Application Default Credentials). Optional in local/test — falls back to a dev-bypass with
# a loud warning if omitted there. See HANDOFF.md / plan notes for the PowerShell command to generate it.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# CORS allowed origins are set directly in application.yml (cors.allowed-origins: "*"),
# the same for every environment — no env var needed here.
