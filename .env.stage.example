# Copy to .env.stage and fill in real values to run/deploy under the "stage" Spring profile.
# Never commit the real .env.stage file.

SPRING_PROFILES_ACTIVE=stage

# Supabase PostgreSQL — Session pooler connection string (stage instance — separate project from prod).
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.bifmeenbywotuvgylgxv
DB_PASSWORD=

PORT=8082

# Required — the app refuses to start in stage without this (or Application Default Credentials
# on GCP/Cloud Run). Never left blank here, unlike the test/local example files.
FIREBASE_SERVICE_ACCOUNT_BASE64=
