# Copy to .env and fill in real values to run the app under the "test" Spring profile manually
# (not needed for ./gradlew test — JUnit tests use application-test.yml directly, no env file).
# application-test.yml already hardcodes an in-memory H2 database, so no DB_URL/DB_USERNAME/
# DB_PASSWORD are needed here.

SPRING_PROFILES_ACTIVE=test
PORT=8081

# Optional — omit to fall back to the dev-bypass (every request treated as a fake verified user,
# with a loud warning). The "test" profile is not prod/stage, so this is allowed to be blank.
FIREBASE_SERVICE_ACCOUNT_BASE64=
